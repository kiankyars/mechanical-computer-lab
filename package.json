{
  "name": "mechanical-computer-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "trace": "tsx scripts/trace.ts",
    "freeze": "tsx scripts/freeze.ts",
    "verify:frozen": "tsx scripts/freeze.ts --check",
    "schema": "tsx scripts/schema.ts",
    "test:built-worker": "tsx scripts/check-built-worker.ts",
    "check": "npm run typecheck && npm test && npm run verify:frozen"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "0.20.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
